<Window x:Class="WorkFlowWidget.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WorkFlowWidget" Width="620" Height="760" MinWidth="480" MinHeight="540"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" Topmost="True" Background="#F5F2EA" Loaded="OnLoaded" Closed="OnClosed">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Background" Value="#E7ECE8"/><Setter Property="Foreground" Value="#334D43"/><Setter Property="BorderBrush" Value="#C9D3CC"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="12,8"/></Style>
  <DataTemplate x:Key="TrackedEmailTemplate">
   <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8"><StackPanel>
    <TextBlock Text="{Binding Email.Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding Email.Sender}" Foreground="#59635F" Margin="0,4,0,0"/>
    <TextBlock Text="{Binding Email.ReceivedAt, StringFormat={}{0:g}}" FontSize="11" Foreground="#59635F"/>
    <TextBlock Text="Reply recorded" Foreground="#334D43" Visibility="{Binding Replied, Converter={StaticResource BoolVisibility}}"/>
    <TextBlock Text="Sync pending" Foreground="#A12F26" Visibility="{Binding SyncPending, Converter={StaticResource BoolVisibility}}"/>
    <WrapPanel Margin="0,10,0,0"><Button Content="Open email" Click="OpenTrackedEmail" Tag="{Binding}"/><Button Content="Mark replied" Click="MarkReplied" Tag="{Binding}"/><Button Content="Needs reply" Click="NeedsReply" Tag="{Binding}"/><Button Content="Retry sync" Click="RetrySync" Tag="{Binding}" Visibility="{Binding SyncPending, Converter={StaticResource BoolVisibility}}"/></WrapPanel>
   </StackPanel></Border>
  </DataTemplate>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="Transparent" MouseLeftButtonDown="DragWindow"><TextBlock Text="WORKFLOW" FontSize="15" FontWeight="Bold" Foreground="#334D43" VerticalAlignment="Center"/><Button Content="×" HorizontalAlignment="Right" Width="32" Click="CloseWindow" ToolTip="Close widget" AutomationProperties.Name="Close widget"/></Grid>
  <Border Grid.Row="1" Background="White" Padding="14" CornerRadius="8" Margin="0,14,0,0"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{Binding Login.Status}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Login.AccountDetails}" Foreground="#59635F" TextWrapping="Wrap" Margin="0,5,8,0"/></StackPanel>
   <Button Grid.Column="1" Content="{Binding Login.ActionLabel}" IsEnabled="{Binding CanAuthenticate}" Click="Authenticate" VerticalAlignment="Center" Background="#334D43" Foreground="White"/>
  </Grid></Border>
  <TextBlock Grid.Row="2" Text="{Binding Login.Error}" TextWrapping="Wrap" Foreground="#A12F26" Margin="0,8,0,8"/>
  <TabControl Grid.Row="3" Background="Transparent" BorderBrush="#C9D3CC" IsEnabled="{Binding CanUse}">
   <TabItem Header="Tickets"><Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding TicketSummary}" TextWrapping="Wrap" Foreground="#59635F" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="1" Text="{Binding TicketError}" TextWrapping="Wrap" Foreground="#A12F26" Margin="0,0,0,8"/>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Projects}"><ItemsControl.ItemTemplate><DataTemplate>
     <Expander IsExpanded="True" Margin="0,0,0,12"><Expander.Header><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Project}" FontWeight="Bold"/><TextBlock Text="{Binding Tickets.Count, StringFormat={}  ({0})}"/></StackPanel></Expander.Header>
      <StackPanel Margin="0,8,0,0"><TextBlock Text="{Binding Error}" Foreground="#A12F26" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Tickets}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8"><StackPanel>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,10"><TextBlock Text="{Binding Id, StringFormat={}#{0}}" Foreground="#59635F" Margin="0,0,10,0"/><TextBlock Text="{Binding WorkItemType}" Foreground="#59635F" Margin="0,0,10,0"/><TextBlock Text="{Binding State}" Foreground="#334D43"/></StackPanel>
        <WrapPanel><Button Content="Open ticket" Click="OpenTicket" Tag="{Binding}"/><Button Content="Close ticket" Click="CloseTicket" Tag="{Binding}"/></WrapPanel>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
     </Expander>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="Email"><Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding EmailSummary}" TextWrapping="Wrap" Foreground="#59635F" Margin="0,0,0,8"/>
    <TextBlock Grid.Row="1" Text="{Binding EmailError}" Foreground="#A12F26" TextWrapping="Wrap" Margin="0,0,0,8"/>
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
     <TabItem Header="Unread"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><ItemsControl ItemsSource="{Binding Unread}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8"><StackPanel>
       <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Sender}" Foreground="#59635F" Margin="0,4,0,0"/><TextBlock Text="{Binding ReceivedAt, StringFormat={}{0:g}}" Foreground="#59635F" FontSize="11"/>
       <WrapPanel Margin="0,10,0,0"><Button Content="New bug" Click="CategorizeBug" Tag="{Binding}"/><Button Content="New ticket" Click="CategorizeTicket" Tag="{Binding}"/><Button Content="Helpdesk query" Click="CategorizeHelpdesk" Tag="{Binding}"/><Button Content="Open email" Click="OpenInboxEmail" Tag="{Binding}"/></WrapPanel>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
     <TabItem Header="New bug"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><ItemsControl ItemsSource="{Binding NewBugs}" ItemTemplate="{StaticResource TrackedEmailTemplate}"/></ScrollViewer></TabItem>
     <TabItem Header="New ticket"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><ItemsControl ItemsSource="{Binding NewTickets}" ItemTemplate="{StaticResource TrackedEmailTemplate}"/></ScrollViewer></TabItem>
     <TabItem Header="Helpdesk query"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><ItemsControl ItemsSource="{Binding Helpdesk}" ItemTemplate="{StaticResource TrackedEmailTemplate}"/></ScrollViewer></TabItem>
     <TabItem Header="Need to reply"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"><ItemsControl ItemsSource="{Binding NeedReply}" ItemTemplate="{StaticResource TrackedEmailTemplate}"/></ScrollViewer></TabItem>
    </TabControl>
   </Grid></TabItem>
  </TabControl>
  <Grid Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="{Binding WorkStatus}" VerticalAlignment="Center" Foreground="#59635F" TextWrapping="Wrap" Margin="0,0,110,0"/><Button Content="Refresh" HorizontalAlignment="Right" IsEnabled="{Binding CanUse}" Click="RefreshWork"/></Grid>
 </Grid>
</Window>
