<Window x:Class="WorkFlowWidget.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WorkFlowWidget" Width="380" Height="430" MinWidth="340" MinHeight="400"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" Topmost="True"
 Background="#F5F2EA" Loaded="OnLoaded" Closed="OnClosed">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid MouseLeftButtonDown="DragWindow" Background="Transparent">
   <TextBlock Text="WORKFLOW" FontSize="15" FontWeight="Bold" Foreground="#334D43" VerticalAlignment="Center"/>
   <Button Content="×" HorizontalAlignment="Right" Width="30" Height="30" Click="CloseWindow" ToolTip="Close widget" AutomationProperties.Name="Close widget"/>
  </Grid>
  <StackPanel Grid.Row="1" Margin="0,32,0,0">
   <TextBlock Text="Your day, in one place." FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="Connect your work Microsoft account to get started." Margin="0,12,0,22" TextWrapping="Wrap" Foreground="#59635F"/>
   <Border Background="White" Padding="16" CornerRadius="10">
    <StackPanel>
     <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding AccountDetails}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#59635F"/>
    </StackPanel>
   </Border>
   <TextBlock Text="{Binding Error}" Foreground="#A12F26" TextWrapping="Wrap" Margin="0,14,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="2">
   <Button Content="{Binding ActionLabel}" IsEnabled="{Binding CanAct}" Click="Authenticate" Padding="12" Background="#334D43" Foreground="White" FontSize="15"/>
   <TextBlock Text="Sign-out affects this widget only." FontSize="11" Foreground="#59635F" Margin="0,10,0,0" HorizontalAlignment="Center"/>
  </StackPanel>
 </Grid>
</Window>
